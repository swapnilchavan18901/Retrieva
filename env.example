# Copy this file to .env in this directory and replace the placeholders.
# The backend API and consumer both read FileMind/.env.

# PostgreSQL (DIRECT_URL is used by Prisma migrations).
DATABASE_URL=postgresql://filemind:replace-with-db-password@localhost:5432/filemind
DIRECT_URL=postgresql://filemind:replace-with-db-password@localhost:5432/filemind

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AWS S3 document storage
AWS_REGION=us-east-1
AWS_S3_BUCKET=replace-with-your-bucket-name
AWS_ACCESS_KEY_ID=replace-with-your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-your-aws-secret-access-key

# RabbitMQ document processing queue
RABBIT_MQ_URL=amqps://username:password@your-rabbitmq-host:5671/vhost
RABBIT_MQ_API_KEY=replace-with-your-rabbitmq-api-key

# Sarvam AI: chat answers and query rewriting
SARVAM_API_KEY=replace-with-your-sarvam-api-key
SARVAM_BASE_URL=https://api.sarvam.ai/v2
SARVAM_MODEL=sarvam-105b

# OpenRouter: openai/text-embedding-3-small (1536 dimensions).
# Embedding requests are charged to your OpenRouter balance.
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key

# Qdrant vector database
QDRANT_DB_CLUSTER_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_DB_API_KEY=replace-with-your-qdrant-api-key

# Benchmark logs: reported API tokens, timings, and cost estimates (no message text).
# BENCHMARK_ENABLED=true
# BENCHMARK_LOG_TO_CONSOLE=true
# BENCHMARK_LOG_PATH=logs/benchmarks-{pid}.jsonl
# Sarvam estimates in INR per million tokens, excluding GST.
# Defaults checked against https://docs.sarvam.ai/api/getting-started/pricing on 2026-10-30.
# Override these if your dashboard/contract shows different rates.
# SARVAM_PRICING_MODEL=sarvam-105b
# SARVAM_INPUT_PRICE_PER_1M_TOKENS=15
# SARVAM_CACHED_INPUT_PRICE_PER_1M_TOKENS=5
# SARVAM_OUTPUT_PRICE_PER_1M_TOKENS=60
