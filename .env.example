# Copy to .env on the server and fill in real values. Never commit the populated .env.
# API port on the Ubuntu host.
API_PORT=8000

# Backend runtime configuration (see Retrieva/env.example for field descriptions).
ENVIRONMENT=production
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["https://app.example.com"]
SOCKET_CORS_ORIGINS=["https://app.example.com"]
HTTP_REQUESTS_PER_MINUTE=120
MAX_BOTS_PER_USER=10
MAX_DOCUMENTS_PER_BOT=50
MAX_API_KEYS_PER_BOT=10

# AWS S3 credentials (prefer an EC2 instance role where available).
AWS_REGION=us-east-1
AWS_S3_BUCKET=replace-with-your-bucket-name
AWS_ACCESS_KEY_ID=replace-with-your-access-key
AWS_SECRET_ACCESS_KEY=replace-with-your-secret-key
# AWS_SESSION_TOKEN=optional-temporary-credential-token

# Hosted Supabase PostgreSQL: use the pooler URL for DATABASE_URL if applicable,
# and Supabase's direct connection URL for DIRECT_URL.
DATABASE_URL=postgresql://YOUR_SUPABASE_CONNECTION_STRING
DIRECT_URL=postgresql://YOUR_SUPABASE_DIRECT_CONNECTION_STRING

# Hosted RabbitMQ connection and Qdrant Cloud cluster.
RABBIT_MQ_URL=amqps://YOUR_RABBITMQ_USER:YOUR_RABBITMQ_PASSWORD@YOUR_RABBITMQ_HOST:5671/YOUR_VHOST
RABBIT_MQ_API_KEY=replace-with-your-rabbitmq-api-key
QDRANT_DB_CLUSTER_URL=https://YOUR_QDRANT_CLUSTER_URL
QDRANT_DB_API_KEY=replace-with-your-qdrant-api-key

# External AI services.
SARVAM_API_KEY=replace-with-your-sarvam-api-key
SARVAM_BASE_URL=https://api.sarvam.ai/v2
SARVAM_MODEL=sarvam-105b
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key

